# ── Background jobs (Upstash QStash) ──────────────────────────────────────
#
# QStash POSTs each queued email back to /api/jobs/email and retries on any
# non-2xx, so there is no worker process to host. Leave these unset locally:
# Upstash cannot reach localhost, and the app falls back to sending inline.
#
# From https://console.upstash.com/qstash
QSTASH_TOKEN=

# Signature keys for verifying incoming job deliveries. Both are needed —
# Upstash rotates them, and accepting the current and the next key means a
# rotation doesn't start rejecting live traffic. Without these the job
# endpoint refuses every delivery, because unsigned it would be an open relay
# for anyone who found the URL.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Where QStash delivers jobs back to. Must be publicly reachable.
API_PUBLIC_URL=https://chowspace-backend.vercel.app
