# ── Background jobs (Upstash QStash) ──────────────────────────────────────
#
# QStash POSTs each queued email back to /api/jobs/email and retries on any
# non-2xx, so there is no worker process to host. Leave these unset locally:
# Upstash cannot reach localhost, and the app falls back to sending inline.
#
# From https://console.upstash.com/qstash
QSTASH_TOKEN=

# Signature keys for verifying incoming job deliveries. Both are needed —
# Upstash rotates them, and accepting the current and the next key means a
# rotation doesn't start rejecting live traffic. Without these the job
# endpoint refuses every delivery, because unsigned it would be an open relay
# for anyone who found the URL.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Where QStash delivers jobs back to. Must be publicly reachable.
API_PUBLIC_URL=https://chowspace-backend.vercel.app

# ── Automated customer WhatsApp messages ─────────────────────────────────
#
# Courtesy message after an order: a warm note on a customer's first order,
# a lighter one after that. Sent via an unofficial WhatsApp Web bot (Baileys)
# running as a separate always-on service (see worker/). Leave WA_ENABLED
# unset locally unless you are testing the whole path end to end.
#
# Master switch. Nothing is sent unless this is exactly "true".
WA_ENABLED=

# Public URL of the Baileys worker (the Render service). QStash delivers
# send jobs to <WA_WORKER_URL>/jobs/whatsapp.
WA_WORKER_URL=

# Global backstop: max messages across all customers per UTC day.
WA_DAILY_CAP=60

# Minimum gap between two sends, enforced inside the worker. Keeps the number
# looking human. Milliseconds.
WA_MIN_INTERVAL_MS=45000

# Upstash Redis (REST). Per-phone order counter, send dedup, opt-out flag,
# daily quota. From https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
